# syntax=docker/dockerfile:1.7
###############################################################################
# Dockerfile.test — контейнер для тестов с libvips (cgo/govips) и ONNX Runtime
# (реальная детекция). Аналог builder-стадии production Dockerfile; прогон —
# с тэгами "libvips,onnx":
#   docker build -f Dockerfile.test -t imager:test .
#   docker run --rm -v "%cd%":/src -w /src imager:test \
#       sh -c "go mod tidy && go test -tags 'libvips onnx' ./... -count=1"
# Модели ONNX скачиваются самим тестовым контейнером (тот же
# docker/download-models.sh, примонтирован в rw-каталог).
# Пример с монтированием каталога и env-переменными источников:
#   docker run --rm -v "%cd%/models":/etc/imager/models -v "%cd%":/src -w /src \
#       -e IMAGER_MODEL_FACE_URL=... -e IMAGER_MODEL_OBJECT_URL=... imager:test \
#       sh -c "download-models.sh && go mod tidy && go test -tags 'libvips onnx' ./... -count=1"
###############################################################################
FROM golang:1.27.0-alpine3.23

ENV CGO_ENABLED=1 \
    GOOS=linux \
    GOARCH=amd64 \
    IMAGER_MODELS_DIR=/etc/imager/models

# cgo-зависимости (libvips, govips) — те же, что в production builder, без
# пиннинга (golang:1.27.0-alpine3.23 базируется на Alpine 3.23). onnxruntime и
# libstdc++/libgcc — из edge (C++23-символ). dl-cdn.alpinelinux.org недоступен
# из Docker — репозитории переопределены на mirror.yandex.ru. curl нужен
# download-models.sh (в production-образе используется busybox wget; здесь
# ставим curl для надёжного следования редиректам).
#
# Пакетный список — единый источник docker/build-deps.sh (тот же, что в
# production Dockerfile): builder-пакеты + edge (onnxruntime). Дополнительно
# ставим tzdata, curl, ca-certificates для тестов.
COPY docker/build-deps.sh /tmp/build-deps.sh
RUN echo "https://mirror.yandex.ru/mirrors/alpine/v3.23/main" > /etc/apk/repositories \
    && echo "https://mirror.yandex.ru/mirrors/alpine/v3.23/community" >> /etc/apk/repositories \
    && sh /tmp/build-deps.sh install-builder \
    && apk add --no-cache tzdata~=2026 curl ca-certificates \
    && echo "https://mirror.yandex.ru/mirrors/alpine/edge/main" >> /etc/apk/repositories \
    && echo "https://mirror.yandex.ru/mirrors/alpine/edge/community" >> /etc/apk/repositories \
    && sh /tmp/build-deps.sh install-edge

WORKDIR /src

# Скрипт скачивания моделей (тот же, что и в production-образе).
COPY docker/download-models.sh /usr/local/bin/download-models.sh
RUN chmod 0755 /usr/local/bin/download-models.sh